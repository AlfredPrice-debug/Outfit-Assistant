# Server-side only. Get this from Google AI Studio (https://aistudio.google.com/apikey).
# Never expose this to the client — all Gemini calls happen in route handlers.
GEMINI_API_KEY=

# Postgres connection string. Railway injects this automatically once you link
# a Postgres instance to this service. For local dev, point at a local Postgres.
# Example: postgresql://user:password@localhost:5432/outfit_assistant
DATABASE_URL=

# Auth.js's session/token encryption secret. Generate one with `npx auth secret`.
AUTH_SECRET=

# The app's own public URL. Required in production on platforms like Railway
# where Auth.js can't reliably infer it from the incoming request (this fails
# silently: the app builds sign-in redirects pointing at its internal
# container address, e.g. http://localhost:8080, instead of the real public
# domain). Not needed for local dev (http://localhost:3000 is inferred fine).
# Example: https://your-app.up.railway.app
AUTH_URL=

# OAuth 2.0 Client ID/Secret from the Google Cloud Console (see DEPLOY.md for
# the exact steps). Used for "Continue with Google" sign-in.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated list of emails allowed to sign in. Google auth succeeding is
# not enough on its own; the email must also appear here (case-insensitive).
# If unset, everyone is rejected.
ALLOWED_EMAILS=

# LOCAL TESTING ONLY. When "true", skips the Google sign-in gate entirely so
# the app can be exercised without completing real OAuth (useful when there's
# no way to complete a real Google sign-in, e.g. an automated environment).
# Every request is treated as a fixed local-test-user (see lib/owner.ts).
# Safe by construction: it also requires RAILWAY_ENVIRONMENT and
# RAILWAY_PROJECT_ID to both be absent, which Railway auto-injects into every
# service and can't be unset from the dashboard, so this can never activate
# in production even if accidentally set there. NEVER set this in Railway.
TEST_BYPASS_AUTH=
