# Server-side only. Get this from Google AI Studio (https://aistudio.google.com/apikey).
# Never expose this to the client — all Gemini calls happen in route handlers.
GEMINI_API_KEY=

# Postgres connection string. Railway injects this automatically once you link
# a Postgres instance to this service. For local dev, point at a local Postgres.
# Example: postgresql://user:password@localhost:5432/outfit_assistant
DATABASE_URL=

# The passcode required to unlock the app. Pick something you haven't reused
# elsewhere — it's the only thing standing between the internet and your Gemini bill.
APP_PASSCODE=

# A stable identifier for the single owner of this app's data. Every database
# row is tagged with this value so a future multi-user upgrade is a config
# change, not a schema rewrite. Any non-empty string works, e.g. your name.
OWNER_ID=
