// Prisma schema for Outfit Me.
//
// Conversation/ChatMessage/Outfit/ClosetItem each carry a `userId` column
// that's a plain indexed string, not a foreign key to User. That was a
// deliberate choice from the single-user era so this exact migration (adding
// real accounts) could be additive-only: rows written before accounts
// existed hold a stale value (the old OWNER_ID string) that never matches a
// real User.id, and enforcing a foreign key would fail against that data on
// deploy. They're intentionally left orphaned rather than backfilled; new
// rows get a real User.id going forward.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Auth.js (@auth/prisma-adapter) models, standard reference shape. Session
// strategy is JWT (see auth.ts), so the Session table is never written to by
// the adapter today; it's included anyway since the adapter's schema
// contract expects it and a future switch to database sessions would need it.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// A conversation is a contiguous chat thread. "Start new chat" archives the
// current one (isArchived: true) and creates a fresh one rather than
// deleting anything, so old messages/outfits stay intact in the database;
// they just stop being the thread that loads on the chat page.
model Conversation {
  id         String        @id @default(cuid())
  userId     String
  isArchived Boolean       @default(false)
  createdAt  DateTime      @default(now())
  messages   ChatMessage[]

  @@index([userId, isArchived, createdAt])
}

model ChatMessage {
  id             String       @id @default(cuid())
  userId         String
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  role           String
  content        String       @db.Text
  createdAt      DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([conversationId, createdAt])
}

model Outfit {
  id               String   @id @default(cuid())
  userId           String
  title            String
  occasion         String
  season           String
  // { top, bottom, outerwear, shoes, accessories: string[] }, kept as JSON
  // rather than columns because the layer set is a UI/prompt concern, not a
  // query concern; nothing filters on individual layers.
  itemsByLayer     Json
  rationale        String   @db.Text
  // { name: string, hex: string }[], 3-5 entries: the color story bar.
  // Unlike inspirationLinks, these are trusted from the model directly (Zod
  // validates hex format, not the color choice itself).
  colorStory       Json
  // { label: string, url: string }[], 0-2 entries, sourced only from Gemini's
  // Google Search grounding metadata. Never populated from model-generated text.
  inspirationLinks Json
  isSaved          Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([userId, isSaved, createdAt])
  @@index([userId, occasion])
  @@index([userId, season])
}

// v2 will let suggestions draw on what the user actually owns. The table
// exists now so that migration is additive-only (new reads/writes against an
// existing table) instead of a schema change layered onto live outfit data.
// No route or query in this codebase touches this model.
model ClosetItem {
  id          String   @id @default(cuid())
  userId      String
  category    String
  colorName   String
  description String
  createdAt   DateTime @default(now())

  @@index([userId])
}
